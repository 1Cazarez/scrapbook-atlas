{
  "name": "scrapbook-atlas",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "pnpm --filter @scrapbook-atlas/api dev",
    "mobile": "pnpm --filter @scrapbook-atlas/mobile start"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
